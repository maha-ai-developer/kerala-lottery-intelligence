# ==============================================================================
# Kerala State Lottery Intelligence & Experiment Platform
# Environment Configuration Template
# DO NOT COMMIT SECRETS OR PRIVATE KEYS TO VERSION CONTROL
# ==============================================================================

# Application & Environment Runtime
NODE_ENV=development
# NEXT_PUBLIC_APP_ENV must be set dynamically by build/deployment ('development' | 'production')
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_GIT_COMMIT_SHA=051cced

# ------------------------------------------------------------------------------
# 1. BROWSER-SAFE PUBLIC FIREBASE WEB CONFIGURATION (Prefix with NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
# These parameters initialize the Firebase Client SDK in the browser.
# For DEV environment (develop branch): targets 'kerala-lottery-intelligence-dev'
# For PROD environment (main branch): targets 'kerala-lottery-intelligence-prod'
# Current local default project: 'kerala-lottery-intelligence'
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyCpxJlxYaM2eVK2NG0pB0-7yLBITsLoBok
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=kerala-lottery-intelligence.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=kerala-lottery-intelligence
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=kerala-lottery-intelligence.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=660682986882
NEXT_PUBLIC_FIREBASE_APP_ID=1:660682986882:web:32a1f0c4549be1f68e2b9b

# Local Firebase Emulator Flags (set to 'true' when running against local emulators)
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY CONFIGURATION (NEVER expose with NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
# Backend and Cloud Run service parameters
GCP_PROJECT_ID=kerala-lottery-intelligence
GCP_REGION=asia-south1

# Cloud Storage Buckets
GCS_BUCKET_DOCUMENTS=kerala-lottery-intelligence-documents-dev
GCS_BUCKET_MODELS=kerala-lottery-intelligence-models-dev

# BigQuery Datasets
BIGQUERY_DATASET_RAW=kerala_lottery_raw
BIGQUERY_DATASET_CANONICAL=kerala_lottery_canonical
BIGQUERY_DATASET_DERIVED=kerala_lottery_derived
BIGQUERY_DATASET_EXPERIMENTS=kerala_lottery_experiments

# ------------------------------------------------------------------------------
# 3. SECRETS (Cloud Secret Manager / Never in git or browser)
# ------------------------------------------------------------------------------
# These must NEVER be prefixed with NEXT_PUBLIC_ or committed to source control.
# In production, provision via: firebase apphosting:secrets:set
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
