# ==============================================================================
# Kerala State Lottery Intelligence & Experiment Platform
# Environment Configuration Template
# DO NOT COMMIT SECRETS OR PRIVATE KEYS TO VERSION CONTROL
# ==============================================================================

# Application & Environment Runtime
NODE_ENV=development
# NEXT_PUBLIC_APP_ENV must be set dynamically by build/deployment ('development' | 'production')
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_GIT_COMMIT_SHA=unknown

# ------------------------------------------------------------------------------
# 1. BROWSER-SAFE PUBLIC FIREBASE WEB CONFIGURATION (Prefix with NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
# Select and copy the appropriate configuration block into your .env.local:
#
# --- OPTION A: DEVELOPMENT ENVIRONMENT (Branch: develop) ---
# Project: Kerala Lottery Intel DEV (ID: kerala-lottery-intel-dev, Number: 608186999779)
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyCctKlDbVa76Yofy6OTebPO2_2Bqa6R2D4
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=kerala-lottery-intel-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=kerala-lottery-intel-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=kerala-lottery-intel-dev.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=608186999779
NEXT_PUBLIC_FIREBASE_APP_ID=1:608186999779:web:316c03af9f7604c0eb36d6

# --- OPTION B: PRODUCTION ENVIRONMENT (Branch: main) ---
# Project: Kerala Lottery Intel PROD (ID: kerala-lottery-intelligence, Number: 660682986882)
# NEXT_PUBLIC_APP_ENV=production
# NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyCpxJlxYaMe2aVK2NG0pB0-7yLBITsLoBok
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=kerala-lottery-intelligence.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=kerala-lottery-intelligence
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=kerala-lottery-intelligence.firebasestorage.app
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=660682986882
# NEXT_PUBLIC_FIREBASE_APP_ID=1:660682986882:web:32a1f0c4549be1f68e2b9b

# Local Firebase Emulator Flags (set to 'true' when running against local emulators)
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY CONFIGURATION (NEVER expose with NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
# Backend and Cloud Run service parameters
GCP_PROJECT_ID=kerala-lottery-intel-dev
GCP_REGION=asia-south1

# Cloud Storage Buckets
GCS_BUCKET_DOCUMENTS=kerala-lottery-intel-dev-documents
GCS_BUCKET_MODELS=kerala-lottery-intel-dev-models

# BigQuery Datasets
BIGQUERY_DATASET_RAW=kerala_lottery_raw
BIGQUERY_DATASET_CANONICAL=kerala_lottery_canonical
BIGQUERY_DATASET_DERIVED=kerala_lottery_derived
BIGQUERY_DATASET_EXPERIMENTS=kerala_lottery_experiments

# ------------------------------------------------------------------------------
# 3. SECRETS (Cloud Secret Manager / Never in git or browser)
# ------------------------------------------------------------------------------
# These must NEVER be prefixed with NEXT_PUBLIC_ or committed to source control.
# In production, provision via: firebase apphosting:secrets:set
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
