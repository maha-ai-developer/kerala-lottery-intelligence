{
  "name": "kerala-lottery-intelligence-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Kerala State Lottery Intelligence & Experiment Platform",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:rules": "npx -y firebase-tools emulators:exec --only firestore \"vitest run tests/firestore-rules.test.ts\"",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.tsx,.js",
    "typecheck": "tsc --noEmit --project tsconfig.base.json",
    "ingest:daily": "npx tsx services/ingestion/scripts/daily-ingestion.ts",
    "ingest:scheduled": "npx tsx services/ingestion/scripts/scheduled-ingestion.ts",
    "bootstrap:prod": "npx tsx services/ingestion/scripts/prod-bootstrap.ts",
    "verify:8c": "npx tsx services/ingestion/scripts/verify-prod-operationalization-8c.ts",
    "verify:prod-activation": "npx tsx services/ingestion/scripts/verify-prod-activation.ts"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^22.13.0",
    "turbo": "^2.11.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": "10.9.8"
  },
  "packageManager": "npm@10.9.8"
}
